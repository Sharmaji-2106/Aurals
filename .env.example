# Copy to .env (backend reads ../.env and ./.env). Every value has a working
# development default; set them explicitly in production.

# Backend (FastAPI + worker)
AURALIS_ENV=development
AURALIS_DATABASE_URL=postgresql+psycopg://auralis:auralis@localhost:5432/auralis
# AURALIS_WORK_DIR=/var/tmp/auralis          # temporary audio lives here during analysis
# AURALIS_WORKER_CONCURRENCY=3                 # analysis processes
# AURALIS_MAX_TRACKS_PER_SUBMISSION=120
# AURALIS_YTDLP_JS_RUNTIME=node                # deno (default if installed), node or bun

# Tests
# AURALIS_TEST_DATABASE_URL=postgresql+psycopg://auralis:auralis@localhost:5432/auralis_test

# Web (Next.js server only; never exposed to the browser)
AURALIS_API_URL=http://127.0.0.1:8000

# Community research (auralis.research). Off by default on purpose: "reddrix"
# retrieves Reddit content through the site's anti-bot defences. See
# docs/decisions.md #26 before enabling it, and install the extra first:
#   uv sync --extra reddit
# AURALIS_REDDIT_PROVIDER=none             # none | reddrix
# AURALIS_REDDIT_STEALTH=off               # off | on | adaptive
# AURALIS_REDDIT_PROXIES=                  # comma-separated, scheme://user:pass@host:port
# AURALIS_RESEARCH_MAX_PRODUCTS=3          # each costs ~23s of searching, measured
# AURALIS_RESEARCH_QUERIES_PER_PRODUCT=2
# AURALIS_RESEARCH_MAX_POSTS_PER_QUERY=6
# AURALIS_RESEARCH_MAX_COMMENTS_PER_POST=8

# Whether scraped community sources are served to the browser. An installation
# can gather evidence and still choose not to publish it.
# AURALIS_REVIEW_SOURCE=curated            # curated | curated+reddit

# Topic and stance labelling for retrieved quotes. Without a key, runs still
# store their sources; they just cannot group them, and the page says so.
# AURALIS_ANTHROPIC_API_KEY=
# AURALIS_LLM_MODEL=claude-opus-5-5

# Topic and stance labelling for community quotes.
#
# Either provider works and neither is required: without a key a research run
# still gathers and stores its sources, it just cannot group them by topic, and
# the run records that it could not rather than guessing.
#
# "auto" prefers Google when its key is present.
AURALIS_LLM_PROVIDER=auto

# Google AI Studio. https://aistudio.google.com/apikey
AURALIS_GOOGLE_API_KEY=
AURALIS_GOOGLE_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary fails. A free tier answers 503 "experiencing
# high demand" per model often enough that one name is not enough, and models
# are retired without notice.
AURALIS_GOOGLE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview

# Anthropic, as an alternative.
AURALIS_ANTHROPIC_API_KEY=
AURALIS_LLM_MODEL=claude-opus-5-5
